# ==============================================================================
# Configuration Environnement Backend - Plateforme CTF
# ==============================================================================

# Base de données PostgreSQL (Contrat AGEA)
# En local ou distante : postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://user:pass@localhost:5432/ctf

# Cache, Rate Limiting & WebSockets Pub/Sub (Contrat AGEA / Infra)
REDIS_URL=redis://localhost:6379/0

# Sécurité & Authentification JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Orchestration Docker (Contrat RES)
# - Si Docker local (1 VM / dév local) : unix:///var/run/docker.sock
# - Si Docker distant (Architecture 2 VM) : tcp://10.10.20.X:2376
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK_PREFIX=ctf_player
TRAEFIK_NETWORK=traefik-net
TRAEFIK_DOMAIN=ctf.local

# Limites & Règles métier
INSTANCE_TIMEOUT_SECONDS=1800
INSTANCE_CPU_LIMIT=0.5
INSTANCE_MEM_LIMIT=256m
